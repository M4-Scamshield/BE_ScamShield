# app 서버(scamshield-app) 의 입구. 도메인 하나로 FE·시그널링·분석을 나눠 보낸다.
# FE 는 모든 요청을 location.host 로 보내므로 같은 도메인이어야 한다(WebRTC 마이크도 HTTPS 필요).
{
	# 보안 그룹이 UDP 443 을 안 연다 → HTTP/3 광고를 끄지 않으면 브라우저가 QUIC 을 먼저 시도하다 늦어진다
	servers {
		protocols h1 h2
	}
}

# www 는 루트로 보낸다 (인증서는 둘 다 Caddy 가 받는다)
www.boostad.site {
	redir https://boostad.site{uri} permanent
}

boostad.site {
	encode gzip

	# 운영 지표·개발용 경로는 밖에서 막는다 (/x, /x/…, /x;… 모두. 앱 쪽도 DEV_ENDPOINTS=false·actuator 8082 로 따로 막음)
	# respond 를 handle 밖에 두면 Caddy 지시어 순서상 handle 이 먼저 잡아 차단이 안 된다(11-15 실측) → handle 로 맨 앞에
	@blocked path_regexp blocked (?i)^/(actuator|api/dev)([/;].*)?$
	handle @blocked {
		respond 404
	}

	# 분석 파이프라인(8081): REST·업로드 WS·SSE. 아래 /api/* 보다 먼저 걸려야 한다
	@pipeline path /api/analysis /api/analysis/* /ws/audio /ws/audio/*
	handle @pipeline {
		reverse_proxy api:8081
	}

	# 팀 시그널링 BE(8080): 통화 방 REST + /ws/signal
	handle /api/* {
		reverse_proxy signal:8080
	}
	handle /ws/* {
		reverse_proxy signal:8080
	}

	# 나머지 = FE 정적 파일 (SPA 라 없는 경로는 index.html)
	handle {
		root * /srv/fe
		try_files {path} /index.html
		file_server
	}
}
