# cp .env.example .env 후 서버에서 직접 채운다. 채팅·커밋에 값을 남기지 않는다.
DB_PASSWORD=
DB_ROOT_PASSWORD=
TYPESAFE_API_KEY=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   (비우면 이 값)
# GEMINI_TIMEOUT_SECONDS=20   (JEV 30초와 합쳐 app 의 agent 대기 55초 안쪽)
STT_MODE=rtzr
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
# 업로드 WS 허용 Origin (쉼표 구분). IP 단계 예: http://1.2.3.4  /  도메인 단계: https://scamshield.example.com
# Discord 음성 수집 확장도 받으려면 뒤에 붙인다: ,chrome-extension://opdocepfbahoocfkahckhnbhdedkibim
ALLOWED_ORIGINS=
