# cp .env.example .env 후 서버에서 직접 채운다. 채팅·커밋에 값을 남기지 않는다.
DB_PASSWORD=
DB_ROOT_PASSWORD=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash   (비우면 이 값)
STT_MODE=rtzr
RTZR_CLIENT_ID=
RTZR_CLIENT_SECRET=
# 업로드 WS 허용 Origin. IP 단계 예: http://1.2.3.4  /  도메인 단계: https://scamshield.example.com
ALLOWED_ORIGINS=
